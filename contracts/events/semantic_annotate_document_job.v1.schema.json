{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structura.local/contracts/events/semantic_annotate_document_job.v1.schema.json",
  "title": "Semantic Annotate Document Job v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "job_id",
    "created_at",
    "document_id",
    "quality_mode",
    "semantic_quality_mode",
    "allow_8b_rescue"
  ],
  "properties": {
    "schema_name": {
      "const": "semantic_annotate_document_job"
    },
    "schema_version": {
      "const": "v1"
    },
    "job_id": {
      "$ref": "../schemas/common_defs.schema.json#/$defs/uuid"
    },
    "correlation_id": {
      "$ref": "../schemas/common_defs.schema.json#/$defs/uuid"
    },
    "created_at": {
      "$ref": "../schemas/common_defs.schema.json#/$defs/timestamp"
    },
    "document_id": {
      "$ref": "../schemas/common_defs.schema.json#/$defs/uuid"
    },
    "quality_mode": {
      "type": "string",
      "enum": ["smart"]
    },
    "semantic_quality_mode": {
      "type": "string",
      "enum": ["smart"]
    },
    "allow_8b_rescue": {
      "type": "boolean",
      "default": false
    },
    "requested_by": {
      "type": "string",
      "enum": ["system", "user", "agent", "scheduler", "reviewer"]
    },
    "requested_by_user_id": {
      "$ref": "../schemas/common_defs.schema.json#/$defs/uuid"
    },
    "user_intent_reason": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "source_semantic_region_id": {
      "$ref": "../schemas/common_defs.schema.json#/$defs/uuid"
    },
    "metadata": {
      "$ref": "../schemas/common_defs.schema.json#/$defs/metadataObject"
    }
  }
}
