{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structura.local/contracts/events/analyze_documents_job.v1.schema.json",
  "title": "Analyze Documents Job v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "job_id",
    "created_at",
    "attempt",
    "priority",
    "document_ids",
    "analysis_note_type",
    "question"
  ],
  "properties": {
    "schema_name": {
      "const": "analyze_documents_job"
    },
    "schema_version": {
      "const": "v1"
    },
    "job_id": {
      "$ref": "../schemas/common_defs.schema.json#/$defs/uuid"
    },
    "correlation_id": {
      "$ref": "../schemas/common_defs.schema.json#/$defs/uuid"
    },
    "created_at": {
      "$ref": "../schemas/common_defs.schema.json#/$defs/timestamp"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "requested_by": {
      "type": "string",
      "enum": [
        "system",
        "user",
        "agent",
        "scheduler"
      ]
    },
    "metadata": {
      "$ref": "../schemas/common_defs.schema.json#/$defs/metadataObject"
    },
    "document_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../schemas/common_defs.schema.json#/$defs/uuid"
      }
    },
    "analysis_note_type": {
      "type": "string",
      "enum": [
        "summary",
        "explanation",
        "comparison",
        "timeline",
        "obligation_scan",
        "tax_scan",
        "medical_explanation"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "include_citations": {
      "type": "boolean",
      "default": true
    },
    "save_result": {
      "type": "boolean",
      "default": true
    }
  }
}
