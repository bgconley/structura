{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structura.local/contracts/events/extract_document_job.v1.schema.json",
  "title": "Extract Document Job v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "job_id",
    "created_at",
    "attempt",
    "priority",
    "document_id",
    "target_schema_name",
    "target_schema_version"
  ],
  "properties": {
    "schema_name": {
      "const": "extract_document_job"
    },
    "schema_version": {
      "const": "v1"
    },
    "job_id": {
      "$ref": "../schemas/common_defs.schema.json#/$defs/uuid"
    },
    "correlation_id": {
      "$ref": "../schemas/common_defs.schema.json#/$defs/uuid"
    },
    "created_at": {
      "$ref": "../schemas/common_defs.schema.json#/$defs/timestamp"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "requested_by": {
      "type": "string",
      "enum": [
        "system",
        "user",
        "agent",
        "scheduler"
      ]
    },
    "metadata": {
      "$ref": "../schemas/common_defs.schema.json#/$defs/metadataObject"
    },
    "document_id": {
      "$ref": "../schemas/common_defs.schema.json#/$defs/uuid"
    },
    "target_schema_name": {
      "type": "string",
      "enum": [
        "document_classification",
        "receipt",
        "invoice",
        "medical_eob",
        "document_observation"
      ]
    },
    "target_schema_version": {
      "type": "string"
    },
    "route_profile": {
      "type": "string"
    },
    "target_pages": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "force_reextract": {
      "type": "boolean",
      "default": false
    },
    "semantic_annotation_id": {
      "$ref": "../schemas/common_defs.schema.json#/$defs/uuid"
    },
    "semantic_region_id": {
      "$ref": "../schemas/common_defs.schema.json#/$defs/uuid"
    },
    "semantic_granite_task": {
      "type": "string",
      "enum": [
        "kvp",
        "tables_json",
        "tables_html",
        "tables_otsl",
        "chart2csv",
        "chart2summary",
        "chart2code"
      ]
    },
    "semantic_type": {
      "type": "string"
    },
    "semantic_expected_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "plan_id": {
      "$ref": "../schemas/common_defs.schema.json#/$defs/uuid"
    },
    "plan_task_id": {
      "$ref": "../schemas/common_defs.schema.json#/$defs/uuid"
    },
    "model_output_schema_name": {
      "type": "string"
    },
    "canonical_target_schema": {
      "type": "string"
    },
    "compatibility_mode": {
      "type": "string",
      "enum": [
        "exact",
        "compatible_alias",
        "generic_review_only",
        "missing"
      ]
    },
    "extractor_backend": {
      "type": "string"
    },
    "contract_resolution_reason": {
      "type": "string"
    },
    "region_envelope_version": {
      "type": "string"
    },
    "semantic_quality_mode": {
      "type": "string",
      "enum": [
        "smart"
      ]
    },
    "requested_by_user_id": {
      "$ref": "../schemas/common_defs.schema.json#/$defs/uuid"
    },
    "user_intent_reason": {
      "type": "string"
    }
  }
}
