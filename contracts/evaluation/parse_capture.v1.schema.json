  "$id": "structura:parse_capture.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "commit": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Commit",
      "type": "string"
    },
    "configuration": {
      "anyOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/ParseConfigurationV2"
            },
            {
              "properties": {
                "output_schema_version": {
                  "const": "structura.page_understanding.v2"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/ParseConfiguration"
            },
            {
              "properties": {
                "output_schema_version": {
                  "const": "structura.page_parse.v1"
                }
              }
            }
          ]
        }
      ],
      "title": "Configuration"
    },
    "configuration_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Configuration Sha256",
      "type": "string"
    },
    "fixture_type": {
      "enum": [
        "deterministic_fixture",
        "model_backed"
      ],
      "title": "Fixture Type",
      "type": "string"
    },
    "item_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Item Id",
      "type": "string"
    },
    "max_output_tokens": {
      "minimum": 1,
      "title": "Max Output Tokens",
      "type": "integer"
    },
    "model_mode": {
      "enum": [
        "fixture",
        "live",
        "required"
      ],
      "title": "Model Mode",
      "type": "string"
    },
    "raw_pages": {
      "items": {
        "$ref": "#/$defs/CapturedRawPage"
      },
      "maxItems": 500,
      "title": "Raw Pages",
      "type": "array"
    },
    "schema_version": {
      "const": "structura.parse_capture.v1",
      "default": "structura.parse_capture.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "structure": {
      "$ref": "#/$defs/DocumentStructure"
    },
    "temperature": {
      "maximum": 2,
      "minimum": 0,
      "title": "Temperature",
      "type": "number"
    }
  },
  "required": [
    "item_id",
    "fixture_type",
    "model_mode",
    "commit",
    "configuration",
    "configuration_sha256",
    "max_output_tokens",
    "temperature",
    "structure",
    "raw_pages"
  ],
  "title": "DocumentCapture",
  "type": "object"
}
