{
  "$defs": {
    "CapturedRawPage": {
      "additionalProperties": false,
      "properties": {
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "raw_output": {
          "maxLength": 2000000,
          "title": "Raw Output",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "page_number",
        "raw_output"
      ],
      "title": "CapturedRawPage",
      "type": "object"
    },
    "DocumentStructure": {
      "additionalProperties": false,
      "properties": {
        "chunks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StructureChunk"
          },
          "title": "Chunks",
          "type": "array"
        },
        "invocations": {
          "items": {
            "anyOf": [
              {
                "allOf": [
                  {
                    "$ref": "#/$defs/ParseInvocationV2"
                  },
                  {
                    "properties": {
                      "output_schema_version": {
                        "const": "structura.page_understanding.v2"
                      }
                    }
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "$ref": "#/$defs/ParseInvocation"
                  },
                  {
                    "properties": {
                      "output_schema_version": {
                        "const": "structura.page_parse.v1"
                      }
                    }
                  }
                ]
              }
            ]
          },
          "title": "Invocations",
          "type": "array"
        },
        "pages": {
          "items": {
            "$ref": "#/$defs/StructurePage"
          },
          "title": "Pages",
          "type": "array"
        },
        "parse_generation_id": {
          "format": "uuid",
          "title": "Parse Generation Id",
          "type": "string"
        },
        "processing_run_id": {
          "format": "uuid",
          "title": "Processing Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "structura.document_structure.v1",
          "default": "structura.document_structure.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceInventory"
        }
      },
      "required": [
        "parse_generation_id",
        "processing_run_id",
        "source",
        "pages",
        "invocations"
      ],
      "title": "DocumentStructure",
      "type": "object"
    },
    "FrozenDocumentContext": {
      "additionalProperties": false,
      "properties": {
        "mime_type": {
          "enum": [
            "application/pdf",
            "image/png",
            "image/jpeg",
            "image/tiff",
            "image/webp"
          ],
          "title": "Mime Type",
          "type": "string"
        },
        "omitted_page_numbers": {
          "items": {
            "type": "integer"
          },
          "maxItems": 500,
          "title": "Omitted Page Numbers",
          "type": "array"
        },
        "original_asset_id": {
          "format": "uuid",
          "title": "Original Asset Id",
          "type": "string"
        },
        "original_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Original Sha256",
          "type": "string"
        },
        "page_count": {
          "maximum": 500,
          "minimum": 1,
          "title": "Page Count",
          "type": "integer"
        },
        "recipe_version": {
          "const": "original-metadata-native-excerpts-v1",
          "title": "Recipe Version",
          "type": "string"
        },
        "selected_pages": {
          "items": {
            "$ref": "#/$defs/NativePageExcerpt"
          },
          "maxItems": 8,
          "title": "Selected Pages",
          "type": "array"
        },
        "source_byte_size": {
          "exclusiveMinimum": 0,
          "maximum": 104857600,
          "title": "Source Byte Size",
          "type": "integer"
        },
        "source_inventory_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Inventory Sha256",
          "type": "string"
        }
      },
      "required": [
        "recipe_version",
        "original_asset_id",
        "original_sha256",
        "mime_type",
        "source_byte_size",
        "source_inventory_sha256",
        "page_count",
        "selected_pages",
        "omitted_page_numbers"
      ],
      "title": "FrozenDocumentContext",
      "type": "object"
    },
    "NativePageExcerpt": {
      "additionalProperties": false,
