{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structura.local/contracts/schemas/invoice.v1.schema.json",
  "title": "Invoice Extraction v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "document_id",
    "seller",
    "invoice",
    "line_items",
    "totals",
    "validation",
    "created_at"
  ],
  "properties": {
    "schema_name": {
      "const": "invoice"
    },
    "schema_version": {
      "const": "v1"
    },
    "document_id": {
      "$ref": "common_defs.schema.json#/$defs/uuid"
    },
    "seller": {
      "$ref": "common_defs.schema.json#/$defs/partyCore"
    },
    "buyer": {
      "$ref": "common_defs.schema.json#/$defs/partyCore"
    },
    "invoice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invoice_number"
      ],
      "properties": {
        "invoice_number": {
          "type": "string",
          "minLength": 1
        },
        "purchase_order_number": {
          "type": "string"
        },
        "issued_on": {
          "$ref": "common_defs.schema.json#/$defs/localDate"
        },
        "due_on": {
          "$ref": "common_defs.schema.json#/$defs/localDate"
        },
        "terms": {
          "type": "string"
        },
        "service_period_start": {
          "$ref": "common_defs.schema.json#/$defs/localDate"
        },
        "service_period_end": {
          "$ref": "common_defs.schema.json#/$defs/localDate"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "common_defs.schema.json#/$defs/evidenceRef"
          }
        }
      }
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "description",
          "amount"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "service_date": {
            "$ref": "common_defs.schema.json#/$defs/localDate"
          },
          "quantity": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "unit_price": {
            "$ref": "common_defs.schema.json#/$defs/money"
          },
          "amount": {
            "$ref": "common_defs.schema.json#/$defs/money"
          },
          "tax_amount": {
            "$ref": "common_defs.schema.json#/$defs/money"
          },
          "gl_hint": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "common_defs.schema.json#/$defs/evidenceRef"
            }
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total"
      ],
      "properties": {
        "subtotal": {
          "$ref": "common_defs.schema.json#/$defs/money"
        },
        "tax_total": {
          "$ref": "common_defs.schema.json#/$defs/money"
        },
        "discount_total": {
          "$ref": "common_defs.schema.json#/$defs/money"
        },
        "shipping_total": {
          "$ref": "common_defs.schema.json#/$defs/money"
        },
        "total": {
          "$ref": "common_defs.schema.json#/$defs/money"
        },
        "amount_paid": {
          "$ref": "common_defs.schema.json#/$defs/money"
        },
        "balance_due": {
          "$ref": "common_defs.schema.json#/$defs/money"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "common_defs.schema.json#/$defs/evidenceRef"
          }
        }
      }
    },
    "confidence": {
      "$ref": "common_defs.schema.json#/$defs/confidenceSummary"
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "needs_review",
        "checks"
      ],
      "properties": {
        "needs_review": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "common_defs.schema.json#/$defs/validationCheck"
          }
        }
      }
    },
    "created_at": {
      "$ref": "common_defs.schema.json#/$defs/timestamp"
    },
    "metadata": {
      "$ref": "common_defs.schema.json#/$defs/metadataObject"
    }
  }
}
