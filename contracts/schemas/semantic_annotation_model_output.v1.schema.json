{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structura.local/contracts/schemas/semantic_annotation_model_output.v1.schema.json",
  "title": "Semantic Annotation Model Output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "document_type",
    "pages",
    "regions",
    "quality_flags"
  ],
  "properties": {
    "schema_name": { "const": "semantic_annotation_model_output" },
    "schema_version": { "const": "v1" },
    "document_type": {
      "type": "string",
      "enum": [
        "medical_eob",
        "insurance_denial",
        "medical_bill",
        "invoice",
        "receipt",
        "retail_order",
        "service_record",
        "real_estate_title",
        "mortgage_escrow_statement",
        "financial_dispute_form",
        "travel_receipt",
        "restaurant_receipt",
        "generic_form",
        "unsupported_document",
        "no_extraction_target",
        "legal",
        "tax",
        "financial",
        "other",
        "unknown"
      ]
    },
    "pages": {
      "type": "array",
      "maxItems": 4,
      "items": { "$ref": "#/$defs/pageAnnotation" }
    },
    "regions": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/regionAnnotation" }
    },
    "quality_flags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "needs_human_review": { "type": "boolean" },
        "visual_degradation": { "type": "boolean" },
        "poor_ocr": { "type": "boolean" },
        "ambiguous_document_type": { "type": "boolean" },
        "reason": { "type": ["string", "null"] }
      }
    },
    "document_type_candidates": {
      "type": "array",
      "maxItems": 4,
      "items": { "$ref": "#/$defs/documentTypeCandidate" }
    },
    "planner_notes": {
      "type": "array",
      "maxItems": 6,
      "items": { "type": "string", "maxLength": 160 }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string"
    },
    "confidence": {
      "type": ["number", "null"]
    },
    "documentTypeCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_type", "confidence", "evidence_terms", "reason"],
      "properties": {
        "document_type": {
          "type": "string",
          "enum": [
            "medical_eob",
            "insurance_denial",
            "medical_bill",
            "invoice",
            "receipt",
            "retail_order",
            "service_record",
            "real_estate_title",
            "mortgage_escrow_statement",
            "financial_dispute_form",
            "travel_receipt",
            "restaurant_receipt",
            "generic_form",
            "unsupported_document",
            "no_extraction_target",
            "legal",
            "tax",
            "financial",
            "other",
            "unknown"
          ]
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "evidence_terms": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "maxLength": 64 }
        },
        "reason": { "type": ["string", "null"], "maxLength": 160 }
      }
    },
    "pageAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_id",
        "page_number",
        "page_role",
        "document_type_hint",
        "extraction_usefulness",
        "is_boilerplate",
        "has_structured_targets",
        "ambiguous",
        "escalation_required",
        "escalation_reasons",
        "reason",
        "confidence"
      ],
      "properties": {
        "page_id": { "$ref": "#/$defs/uuid" },
        "page_number": { "type": "integer", "minimum": 1 },
        "page_role": {
          "type": "string",
          "enum": [
            "document_header",
            "claim_summary",
            "payment_summary",
            "line_items",
            "denial_or_decision",
            "instructions",
            "contact_or_identity",
            "terms_or_boilerplate",
            "signature_or_authorization",
            "image_or_figure",
            "mixed",
            "unknown"
          ]
        },
        "document_type_hint": {
          "type": ["string", "null"],
          "enum": [
            "medical_eob",
            "insurance_denial",
            "medical_bill",
            "invoice",
            "receipt",
            "retail_order",
            "service_record",
            "real_estate_title",
            "mortgage_escrow_statement",
            "financial_dispute_form",
            "travel_receipt",
            "restaurant_receipt",
            "generic_form",
            "unsupported_document",
            "no_extraction_target",
            "legal",
            "tax",
            "financial",
            "other",
            "unknown",
            null
          ]
        },
        "extraction_usefulness": {
          "type": "string",
          "enum": ["none", "low", "medium", "high", "unknown"]
        },
        "is_boilerplate": { "type": "boolean" },
        "has_structured_targets": { "type": "boolean" },
        "ambiguous": { "type": "boolean" },
        "escalation_required": { "type": "boolean" },
        "escalation_reasons": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "enum": [
              "poor_ocr",
              "ambiguous_document_type",
              "missing_docling_grounding",
              "high_risk_domain",
              "low_confidence",
              "validation_sensitive",
              "unsupported_schema",
              "visual_degradation"
            ]
          },
          "default": []
        },
        "reason": { "type": ["string", "null"] },
        "confidence": { "$ref": "#/$defs/confidence" },
        "page_family_hints": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "enum": [
              "medical_eob",
              "insurance_denial",
              "medical_bill",
              "invoice",
              "receipt",
              "retail_order",
              "service_record",
              "real_estate_title",
              "mortgage_escrow_statement",
              "financial_dispute_form",
              "travel_receipt",
              "restaurant_receipt",
              "generic_form",
              "unsupported_document",
              "no_extraction_target",
              "legal",
              "tax",
              "financial",
              "other",
              "unknown"
            ]
          }
        },
        "continuation_group": { "type": ["string", "null"], "maxLength": 80 },
        "docling_table_signal": {
          "type": "string",
          "enum": ["none", "weak", "strong", "unknown"]
        },
        "requires_cross_page_context": { "type": "boolean" },
        "material_region_count_hint": { "type": ["integer", "null"], "minimum": 0, "maximum": 12 }
      }
    },
    "regionAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_type",
        "priority",
        "granite_task",
        "target_schema",
        "expected_fields",
        "grounding",
        "review_required",
        "reason",
        "confidence"
      ],
      "properties": {
        "semantic_type": {
          "type": "string",
          "enum": [
            "document_header",
            "billing_summary",
            "payment_summary",
            "patient_responsibility_summary",
            "covered_services_line_item_table",
            "invoice_line_item_table",
            "receipt_line_item_table",
            "retail_order_line_item_table",
            "service_record_line_item_table",
            "receipt_payment_summary",
            "denial_or_coverage_decision",
            "appeal_or_next_steps",
            "seller_information_block",
            "escrow_summary",
            "mortgage_payment_summary",
            "dispute_transaction_table",
            "dispute_reason_block",
            "generic_form_kvp",
            "no_extraction_target",
            "unsupported_document_region",
            "tax_summary",
            "legal_clause",
            "contact_block",
            "vehicle_or_asset_block",
            "signature_block",
            "boilerplate",
            "unmatched_region",
            "unknown"
          ]
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "granite_task": {
          "type": ["string", "null"],
          "enum": ["kvp", "tables_json", "tables_html", "tables_otsl", "ignore", null]
        },
        "target_schema": {
          "type": ["string", "null"],
          "enum": ["receipt", "invoice", "medical_eob", "document_observation", null]
        },
        "expected_fields": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string" }
        },
        "grounding": { "$ref": "#/$defs/grounding" },
        "review_required": { "type": "boolean" },
        "reason": { "type": ["string", "null"] },
        "confidence": { "$ref": "#/$defs/confidence" },
        "importance": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "source_signal": {
          "type": "string",
          "enum": ["text", "table", "visual", "mixed"]
        },
        "coverage_role": {
          "type": "string",
          "enum": ["primary", "continuation", "summary", "supporting", "boilerplate", "unknown"]
        },
        "extraction_scope": {
          "type": "string",
          "enum": ["table", "element", "page", "multi_page_group"]
        },
        "requires_full_page_image": { "type": "boolean" },
        "continuation_group": { "type": ["string", "null"], "maxLength": 80 },
        "must_extract_reason": { "type": ["string", "null"], "maxLength": 180 },
        "negative_routing_reason": { "type": ["string", "null"], "maxLength": 180 },
        "min_expected_items": { "type": ["integer", "null"], "minimum": 0, "maximum": 500 },
        "visual_bbox_hint": { "$ref": "#/$defs/visualBboxHint" }
      }
    },
    "visualBboxHint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x1", "y1", "x2", "y2"],
      "properties": {
        "x1": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "y1": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "x2": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "y2": { "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    },
    "grounding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "page_id", "element_id", "table_id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["page", "element", "table", "unmatched_region"]
        },
        "page_id": { "type": ["string", "null"] },
        "element_id": { "type": ["string", "null"] },
        "table_id": { "type": ["string", "null"] }
      }
    }
  }
}
