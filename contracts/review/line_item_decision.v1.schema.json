          "$ref": "#/$defs/ExistingLineTarget"
        },
        "comment": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment"
        }
      },
      "required": [
        "operation",
        "source",
        "target"
      ],
      "title": "ReplaceLineDecision",
      "type": "object"
    },
    "VacantLineTarget": {
      "additionalProperties": false,
      "properties": {
        "lineItemType": {
          "enum": [
            "generic",
            "receipt_item",
            "invoice_item",
            "service_line",
            "payment",
            "tax",
            "adjustment",
            "fee"
          ],
          "title": "Lineitemtype",
          "type": "string"
        },
        "ordinal": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Ordinal",
          "type": "integer"
        },
        "canonicalLineItemId": {
          "title": "Canonicallineitemid",
          "type": "null"
        },
        "expectedCanonicalUpdatedAt": {
          "title": "Expectedcanonicalupdatedat",
          "type": "null"
        },
        "expectedLineDecisionRevision": {
          "title": "Expectedlinedecisionrevision",
          "type": "null"
        }
      },
      "required": [
        "lineItemType",
        "ordinal",
        "canonicalLineItemId",
        "expectedCanonicalUpdatedAt",
        "expectedLineDecisionRevision"
      ],
      "title": "VacantLineTarget",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "create": "#/$defs/CreateLineDecision",
      "reject_candidate": "#/$defs/RejectCandidateLineDecision",
      "reject_selected": "#/$defs/RejectSelectedLineDecision",
      "replace": "#/$defs/ReplaceLineDecision"
    },
    "propertyName": "operation"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/CreateLineDecision"
    },
    {
      "$ref": "#/$defs/ReplaceLineDecision"
    },
