        "comment": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment"
        }
      },
      "required": [
        "operation",
        "target"
      ],
      "title": "RejectSelectedLineDecision",
      "type": "object"
    },
    "ReplaceLineDecision": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "replace",
          "title": "Operation",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/LineSourceExpectation"
        },
