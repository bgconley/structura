STRUCTURA_ENV=development
STRUCTURA_RUNTIME_ROOT=/srv/structura
STRUCTURA_DATABASE_URL=postgresql://structura:structura@localhost:5432/structura
STRUCTURA_POSTGRES_BIND_HOST=127.0.0.1
STRUCTURA_API_HOST=0.0.0.0
STRUCTURA_API_BIND_HOST=127.0.0.1
STRUCTURA_API_PORT=8000
STRUCTURA_WEB_BIND_HOST=127.0.0.1
STRUCTURA_WEB_ORIGIN=http://localhost:3000
# Local HTTP profile: use the exact browser origin, including its exposed port.
# For TLS, set an https origin AND STRUCTURA_SESSION_COOKIE_SECURE=true.
# Proxy forwarding must preserve Origin; arbitrary forwarded hosts are not trusted.
STRUCTURA_SESSION_COOKIE_SECURE=false
STRUCTURA_SESSION_COOKIE_NAME=structura_session
STRUCTURA_CSRF_COOKIE_NAME=structura_csrf
STRUCTURA_SESSION_TTL_MINUTES=1440
STRUCTURA_MAGIC_LINK_TTL_MINUTES=15
STRUCTURA_API_UPSTREAM=http://api:8000
VITE_STRUCTURA_API_BASE_URL=
STRUCTURA_CONTRACTS_DIR=contracts
STRUCTURA_DATABASE_DIR=database
STRUCTURA_MAX_UPLOAD_BYTES=104857600
STRUCTURA_ENABLE_MODEL_PLACEHOLDERS=false
